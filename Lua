local function ensureIcons()
	if Lib.IconsTried then
		return Lib.Icons
	end
	Lib.IconsTried = true
	local ok, res = pcall(function()
		return loadstring(game:HttpGetAsync(ICONS_URL))()
	end)
	if ok and res then
		Lib.Icons = res
		pcall(function()
			Lib.Icons.SetIconsType("lucide")
		end)
	else
		warn("[HE] Icons V2 failed to load, using fallback glyphs.")
	end
	return Lib.Icons
end

function HE.SetIconsType(iconType)
	local icons = ensureIcons()
	if icons then
		pcall(function()
			icons.SetIconsType(iconType)
		end)
	end
end

local function resolveIcon(icon)
	if icon == nil or icon == "" then
		return nil
	end
	if type(icon) == "number" then
		return "rbxassetid://" .. tostring(icon)
	end
	if type(icon) == "string" then
		if icon:find("rbxassetid://", 1, true) or icon:find("rbxthumb://", 1, true) or icon:find("http", 1, true) == 1 then
			return icon
		end
		if icon:match("^%d+$") then
			return "rbxassetid://" .. icon
		end
		local icons = ensureIcons()
		if icons then
			local ok, res = pcall(function()
				return icons.GetIcon(icon)
			end)
			if ok and res then
				return res
			end
		end
	end
	return nil
end

local function setIcon(label, icon)
	local r = resolveIcon(icon)
	if type(r) == "table" then
		label.Image = r.Image or r.image or r[1] or ""
		local ro = r.ImageRectPosition or r.ImageRectOffset
		if ro then
			label.ImageRectOffset = ro
		end
		if r.ImageRectSize then
			label.ImageRectSize = r.ImageRectSize
		end
		return true
	elseif type(r) == "string" then
		label.Image = r
		return true
	end
	return false
end

