function WindowMT:Dialog(o)
	o = o or {}
	local overlay = New("TextButton", { BackgroundColor3 = BLACK, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 300, Active = true, Parent = self.Gui })
	local box = New("Frame", {
		BackgroundColor3 = State.Theme.Panel, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0, 320, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = overlay,
	})
	corner(box, 8)
