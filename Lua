	CanvasGroup = { BorderSizePixel = 0 },
	TextLabel = { BackgroundTransparency = 1, BorderSizePixel = 0, Font = FONT, TextSize = 13, TextColor3 = WHITE },
	TextButton = { BackgroundTransparency = 1, AutoButtonColor = false, BorderSizePixel = 0, Font = FONT, TextSize = 13, TextColor3 = WHITE, Text = "" },
