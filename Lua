-- ---------- Button ----------
function Elements:CreateButton(o)
	if type(o) == "string" then
		o = { Name = o }
	end
	local win = self.Window
	local row = buildRow(self, o, o._RightReserve or 0)
	local hit = New("TextButton", { Size = UDim2.fromScale(1, 1), ZIndex = 2, Parent = row })
	hoverFx(hit, row)
	rippleOn(hit, row)
	local fav = { suppress = false }
	local function fire()
		playSound()
		safeCall(o.Callback)
	end
	local entry
	if not o._Proxy then
		entry = win:_RegisterBind({ Name = o.Name or "Button", Kind = "Button", Keybind = o.Keybind, Fire = fire })
		entry.Proxy = function(tab)
			tab:CreateButton({ Name = o.Name, Description = "Pinned shortcut", Callback = o.Callback, _Proxy = true })
		end
		fav = attachFavorite(win, row, entry)
	end
	hit.Activated:Connect(function()
		if fav.suppress then
			return
		end
		fire()
	end)
	self:_Add(row, o.Name or "Button", "Button", o._Proxy)
	local obj = { Frame = row, Fire = fire }
	function obj:SetName(t)
		row:FindFirstChildWhichIsA("TextLabel", true).Text = t
	end
	return obj
end

