	tab:CreateSection("Appearance")
	tab:CreateDropdown({ Name = "Theme Preset", Options = HE.ThemeNames, Default = State.ThemeName, Flag = "UI_Theme", Callback = function(v) if v then self:SetTheme(v) end end })
	tab:CreateDropdown({ Name = "Accent Color", Description = "Choose from 30 named colors.", Options = HE.ColorNames, Default = State.AccentName, Search = true, Flag = "UI_Accent", Callback = function(v) if v then self:SetAccent(v) end end })
