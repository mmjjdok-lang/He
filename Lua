}

local function New(class, props)
	local inst = Instance.new(class)
	inst.Name = rn()
	for k, v in pairs(DEFAULTS[class] or {}) do
		inst[k] = v
	end
	local parent
	for k, v in pairs(props or {}) do
		if k == "Parent" then
			parent = v
		else
			inst[k] = v
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function list(parent, padding, dir, ha, va)
	return New("UIListLayout", {
		Padding = UDim.new(0, padding or 0),
		FillDirection = dir or Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = ha or Enum.HorizontalAlignment.Left,
		VerticalAlignment = va or Enum.VerticalAlignment.Top,
		Parent = parent,
	})
end

local function pad(parent, t, b, l, r)
	return New("UIPadding", {
		PaddingTop = UDim.new(0, t or 0), PaddingBottom = UDim.new(0, b or 0),
		PaddingLeft = UDim.new(0, l or 0), PaddingRight = UDim.new(0, r or 0),
		Parent = parent,
	})
end

local function corner(parent, r)
	return New("UICorner", { CornerRadius = UDim.new(0, r or 6), Parent = parent })
end

local function stroke(parent, color, thickness, transparency)
	return New("UIStroke", {
		Color = color or WHITE, Thickness = thickness or 1, Transparency = transparency or 0.85,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = parent,
	})
end

local function tw(inst, t, props, style, dir)
	local tween = TweenService:Create(inst, TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
	tween:Play()
	return tween
end

-- Theme binding -------------------------------------------------
local function themeColor(key)
	if key == "Accent" then
		return State.Accent
	end
	return State.Theme[key]
end

local function bind(inst, prop, key)
	inst[prop] = themeColor(key)
	table.insert(Bound, { inst, prop, key })
	return inst
end

local function addRefresher(fn)
	table.insert(Refreshers, fn)
end

local function applyTheme(animate)
	local i = 1
	while i <= #Bound do
		local b = Bound[i]
		if b[1] and b[1].Parent then
			if animate then
				tw(b[1], 0.3, { [b[2]] = themeColor(b[3]) })
			else
				b[1][b[2]] = themeColor(b[3])
			end
			i = i + 1
		else
			table.remove(Bound, i)
		end
	end
	for _, fn in ipairs(Refreshers) do
		pcall(fn)
	end
end

local function playSound(id)
	pcall(function()
		local s = Instance.new("Sound")
		s.SoundId = id or CLICK_SOUND
		s.Volume = 0.4
		s.Parent = SoundService
		s:Play()
		Debris:AddItem(s, 3)
	end)
end

