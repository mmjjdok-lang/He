	pad(box, 16, 16, 16, 16)
	list(box, 10)
	New("TextLabel", { Size = UDim2.new(1, 0, 0, 18), Text = o.Title or "Confirm", TextXAlignment = Enum.TextXAlignment.Left, Font = FONT_BOLD, TextSize = 15, LayoutOrder = 1, Parent = box })
	New("Frame", { BackgroundColor3 = WHITE, Size = UDim2.fromOffset(32, 2), LayoutOrder = 2, Parent = box })
	New("TextLabel", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Text = o.Content or "", TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextSize = 12, Font = FONT_REG,
		TextColor3 = State.Theme.SubText, LayoutOrder = 3, Parent = box,
	})
	local brow = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 32), LayoutOrder = 4, Parent = box })
	list(brow, 8, Enum.FillDirection.Horizontal)
	local buttons = o.Buttons or { { Name = "OK" } }
	local closed = false
	local function close()
		if closed then
			return
		end
		closed = true
		tw(overlay, 0.2, { BackgroundTransparency = 1 })
		tw(sc, 0.2, { Scale = 0.9 })
		task.delay(0.22, function()
			overlay:Destroy()
		end)
	end
	for i, b in ipairs(buttons) do
		local n = #buttons
		local btn = New("TextButton", {
			BackgroundTransparency = 0, BackgroundColor3 = b.Accent and State.Accent or State.Theme.Element, LayoutOrder = i,
			Size = UDim2.new(1 / n, -(8 * (n - 1)) / n, 1, 0), Text = b.Name or "OK", Font = FONT_BOLD,
			TextColor3 = b.Accent and BLACK or WHITE, ClipsDescendants = true, Parent = brow,
		})
		corner(btn, 6)
		btn.InputBegan:Connect(function(inp)
			if inp.UserInputType == Enum.UserInputType.Touch or inp.UserInputType == Enum.UserInputType.MouseButton1 then
				ripple(btn, inp.Position.X, inp.Position.Y)
			end
		end)
		btn.Activated:Connect(function()
			playSound()
			close()
			safeCall(b.Callback)
		end)
	end
	tw(overlay, 0.25, { BackgroundTransparency = 0.45 })
	tw(sc, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	return { Close = close }
end

