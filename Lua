function WindowMT:_Flag(key, getter, setter)
	if not key then
		return
	end
	self.Flags[key] = { Get = getter, Set = setter }
end

function WindowMT:_RegisterBind(info)
	local id = info.Kind .. ":" .. info.Name
	local n = 1
	local base = id
	local function exists(x)
		for _, b in ipairs(self.Binds) do
			if b.Id == x then
				return true
			end
		end
		return false
	end
	while exists(id) do
		n = n + 1
		id = base .. " (" .. n .. ")"
	end
	local key = toKey(info.Keybind)
	local e = { Id = id, Name = info.Name, Kind = info.Kind, Key = key, Enabled = key ~= nil, Fire = info.Fire }
	table.insert(self.Binds, e)
	if self.KBRefresh then
		self.KBRefresh()
	end
	return e
end

function WindowMT:_RefreshFavorites()
	local tab = self.FavTab
	if not tab then
		return
	end
	tab:Clear()
	local count = 0
	for _, e in ipairs(self.Binds) do
		if self.FavSet[e.Id] and e.Proxy then
			count = count + 1
			e.Proxy(tab)
		end
	end
	if count == 0 then
		tab:CreateLabel({ Text = "No favorites yet. Right-click (PC) or long-press (mobile) a Button or Toggle to pin it here.", _Proxy = true })
	end
end

function WindowMT:_Changed()
	if self._loading or not self.AutoSave then
		return
	end
	self._saveToken = (self._saveToken or 0) + 1
	local t = self._saveToken
	task.delay(1, function()
		if t == self._saveToken and self.Gui and self.Gui.Parent then
			self:SaveConfig(nil, true)
		end
	end)
end

local function encodeValue(v)
	if typeof(v) == "Color3" then
		return { __color = { v.R, v.G, v.B } }
	end
	return v
end

local function configPath(name)
	return CONFIG_FOLDER .. "/" .. name .. ".json"
end

function WindowMT:SaveConfig(name, silent)
	name = name or self.ConfigName
	if typeof(writefile) ~= "function" then
		if not silent then
			HE:Notify({ Title = "Config", Content = "File system is not supported.", Type = "Warning" })
		end
		return false
	end
	local data = { Flags = {}, Binds = {}, Favs = {} }
	for k, f in pairs(self.Flags) do
		local ok, v = pcall(f.Get)
		if ok then
			data.Flags[k] = encodeValue(v)
		end
	end
	for _, b in ipairs(self.Binds) do
		data.Binds[b.Id] = { Key = b.Key and b.Key.Name or "None", Enabled = b.Enabled }
	end
	for id in pairs(self.FavSet) do
		table.insert(data.Favs, id)
	end
	local ok = pcall(function()
		if typeof(isfolder) == "function" and not isfolder(CONFIG_FOLDER) then
			makefolder(CONFIG_FOLDER)
		end
		writefile(configPath(name), HttpService:JSONEncode(data))
	end)
	if not silent then
		HE:Notify({ Title = "Config", Content = ok and ("Saved: " .. name) or "Failed to save config.", Type = ok and "Success" or "Error", Duration = 2.5 })
	end
	return ok
end

function WindowMT:LoadConfig(name, silent)
	name = name or self.ConfigName
	if typeof(readfile) ~= "function" or typeof(isfile) ~= "function" or not isfile(configPath(name)) then
		if not silent then
			HE:Notify({ Title = "Config", Content = "No saved config found.", Type = "Warning", Duration = 2.5 })
		end
		return false
	end
	local ok, data = pcall(function()
		return HttpService:JSONDecode(readfile(configPath(name)))
	end)
	if not ok or type(data) ~= "table" then
		return false
	end
	self._loading = true
	for k, v in pairs(data.Flags or {}) do
		local f = self.Flags[k]
		if f then
			pcall(f.Set, v, false)
		end
	end
	for id, b in pairs(data.Binds or {}) do
		for _, e in ipairs(self.Binds) do
			if e.Id == id then
				e.Key = toKey(b.Key)
				e.Enabled = b.Enabled == true and e.Key ~= nil
			end
		end
	end
	table.clear(self.FavSet)
	for _, id in ipairs(data.Favs or {}) do
		self.FavSet[id] = true
	end
	for _, e in ipairs(self.Binds) do
		e.Pinned = self.FavSet[e.Id] == true
	end
	self._loading = false
	self:_RefreshFavorites()
	if self.KBRefresh then
		self.KBRefresh()
	end
	if not silent then
		HE:Notify({ Title = "Config", Content = "Loaded: " .. name, Type = "Success", Duration = 2.5 })
	end
	return true
end

