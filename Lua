local NotifColors = {
	Success = rgb(46, 204, 113), Warning = rgb(243, 156, 18), Error = rgb(231, 76, 60),
}

function HE:Notify(o)
	if type(o) == "string" then
		o = { Content = o }
	end
	o = o or {}
	local gui = ensureGui()
	if not (Lib.NotifHolder and Lib.NotifHolder.Parent) then
		Lib.NotifHolder = New("Frame", {
			BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -14, 1, -14),
			Size = UDim2.fromOffset(270, 0), AutomaticSize = Enum.AutomaticSize.Y, ZIndex = 400, Parent = gui,
		})
		list(Lib.NotifHolder, 8, Enum.FillDirection.Vertical, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Bottom)
	end
	Lib.NotifCount = Lib.NotifCount + 1
	local dur = o.Duration or 4
	local col = NotifColors[o.Type or ""] or State.Accent
	local outer = New("Frame", {
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = Lib.NotifCount, Parent = Lib.NotifHolder,
	})
	local card = New("Frame", {
		BackgroundColor3 = State.Theme.Panel, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		Position = UDim2.new(1, 60, 0, 0), ClipsDescendants = true, Parent = outer,
	})
	corner(card, 6)
	New("Frame", { BackgroundColor3 = col, Size = UDim2.new(0, 3, 1, 0), Parent = card })
	local content = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = card })
