-- Visibility / compact mode
function WindowMT:SetVisible(v)
	if v == self.Visible then
		return
	end
	self.Visible = v
	local target = self.AutoScale * State.UserScale
	if v then
		self.Main.Visible = true
		self.UIScale.Scale = target * 0.92
		tw(self.UIScale, 0.3, { Scale = target }, Enum.EasingStyle.Back)
		tw(self.Main, 0.25, { GroupTransparency = State.Transparency })
	else
		tw(self.Main, 0.2, { GroupTransparency = 1 })
		tw(self.UIScale, 0.2, { Scale = target * 0.92 })
		task.delay(0.21, function()
			if not self.Visible then
				self.Main.Visible = false
			end
		end)
	end
end

function WindowMT:Toggle()
	self:SetVisible(not self.Visible)
end

function WindowMT:SetCompact(c)
	self.Compact = c
	local full = self.SizeFull
	if c then
		tw(self.Main, 0.3, { Size = UDim2.new(full.X.Scale, full.X.Offset, 0, TOP_H) })
		task.delay(0.28, function()
			if self.Compact then
				self.Body.Visible = false
			end
		end)
		self.TitleHolder.Position = UDim2.new(0, 150, 0, 0)
		self.TitleHolder.Size = UDim2.new(1, -300, 1, 0)
		self.Title.TextXAlignment = Enum.TextXAlignment.Center
		self.Subtitle.TextXAlignment = Enum.TextXAlignment.Center
	else
		self.Body.Visible = true
		tw(self.Main, 0.3, { Size = full })
		self.TitleHolder.Position = UDim2.new(0, self.IconW, 0, 0)
		self.TitleHolder.Size = UDim2.new(1, -(self.IconW + 140), 1, 0)
