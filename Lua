function TabMT:_Add(frame, name, kind, proxy)
	table.insert(self.Items, frame)
	local idx = #self.Items
	frame.LayoutOrder = idx
	frame.Parent = self.Columns[((idx - 1) % self.ColCount) + 1]
	if not proxy then
		table.insert(self.Window.Elements, { Name = name or "Element", Kind = kind, Tab = self, Frame = frame })
	end
end

function TabMT:_SetScrolling(b)
	self.Page.ScrollingEnabled = b
end

function TabMT:Clear()
	for _, f in ipairs(self.Items) do
		f:Destroy()
	end
	table.clear(self.Items)
end

-- Button splitter: distribute elements across up to 3 columns
function TabMT:Split(n)
	n = math.clamp(math.floor(tonumber(n) or 1), 1, 3)
	self.ColCount = n
	for i = 1, 3 do
		local col = self.Columns[i]
		col.Visible = i <= n
		col.Size = UDim2.new(1 / n, -(8 * (n - 1)) / n, 0, 0)
	end
	for idx, item in ipairs(self.Items) do
		item.LayoutOrder = idx
		item.Parent = self.Columns[((idx - 1) % n) + 1]
	end
end

function TabMT:Select()
	self.Window:SelectTab(self)
end

local function createTab(win, o, parentHolder, indent)
	o = o or {}
	local tab = setmetatable({ Window = win, Name = o.Name or "Tab", Items = {}, ColCount = 1, Kind = "Tab" }, TabMT)
	win.Counter = win.Counter + 10
	tab.Order = o.Order or win.Counter
	tab.EndOrder = tab.Order
	tab.ParentHolder = parentHolder
	local entry = New("TextButton", { Size = UDim2.new(1, 0, 0, 32), LayoutOrder = tab.Order, ClipsDescendants = true, Parent = parentHolder })
	corner(entry, 5)
	local ind = New("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.fromOffset(2, 0), Parent = entry })
	bind(ind, "BackgroundColor3", "Accent")
	local ic = New("ImageLabel", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 10 + indent, 0.5, 0), Size = UDim2.fromOffset(16, 16), Parent = entry })
	local hasIcon = o.Icon and setIcon(ic, o.Icon) or false
	ic.Visible = hasIcon
	local lbl = New("TextLabel", {
		Position = UDim2.new(0, (hasIcon and 34 or 12) + indent, 0, 0), Size = UDim2.new(1, -(46 + indent), 1, 0),
		Text = tab.Name, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = entry,
	})
	if o.Tag then
		local pill, w = makeTag(entry, o.Tag)
		if pill then
			pill.AnchorPoint = Vector2.new(1, 0.5)
			pill.Position = UDim2.new(1, -6, 0.5, 0)
			lbl.Size = UDim2.new(1, -(52 + indent + w), 1, 0)
		end
	end
	local page = New("ScrollingFrame", { Size = UDim2.fromScale(1, 1), Visible = false, Parent = win.PageHolder })
	pad(page, 6, 10, 6, 6)
	local holder = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = page })
	list(holder, 8, Enum.FillDirection.Horizontal)
	tab.Columns = {}
	for i = 1, 3 do
		local col = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(i == 1 and 1 or 0, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = i, Visible = i == 1, Parent = holder })
		list(col, 6)
		tab.Columns[i] = col
	end
	tab.Page, tab.Entry, tab.Indicator, tab.Label, tab.Icon = page, entry, ind, lbl, ic
	function tab:_Style(animate)
		local active = (win.Current == tab)
		local c = active and State.Theme.Text or State.Theme.SubText
		if animate then
			tw(lbl, 0.2, { TextColor3 = c })
			tw(ic, 0.2, { ImageColor3 = c })
			tw(ind, 0.2, { Size = UDim2.fromOffset(2, active and 16 or 0) })
			tw(entry, 0.2, { BackgroundTransparency = active and 0.9 or 1 })
		else
			lbl.TextColor3, ic.ImageColor3 = c, c
			ind.Size = UDim2.fromOffset(2, active and 16 or 0)
			entry.BackgroundTransparency = active and 0.9 or 1
		end
	end
	entry.BackgroundColor3 = WHITE
	tab:_Style(false)
	addRefresher(function()
		tab:_Style(false)
	end)
	entry.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
			ripple(entry, i.Position.X, i.Position.Y)
		end
	end)
	entry.Activated:Connect(function()
		win:SelectTab(tab)
	end)
	win.TabByName[tab.Name] = tab
	if o.SectionName then
		tab:CreateSection(o.SectionName)
	end
	return tab
end

function WindowMT:SelectTab(tab)
	if self.SearchBox and self.SearchBox.Text ~= "" then
		self.SearchBox.Text = ""
	end
	if self.Current == tab then
		return
	end
	local old = self.Current
	self.Current = tab
	if old then
		old.Page.Visible = false
		old:_Style(true)
	end
	tab.Page.Position = UDim2.fromOffset(16, 0)
	tab.Page.Visible = true
	tw(tab.Page, 0.3, { Position = UDim2.fromOffset(0, 0) })
	tab:_Style(true)
end

function WindowMT:CreateTab(o)
	local tab = createTab(self, o, self.TabHolder, 0)
	if o and o.SpacingAfter then
		self:CreateTabSpacing(tab.Name)
	end
	if not self.Current and tab ~= self.FavTab then
		self:SelectTab(tab)
	end
	return tab
end

-- Tab dropdown (nested tabs)
function WindowMT:CreateTabDropdown(o)
	o = o or {}
	local win = self
	self.Counter = self.Counter + 10
	local order = self.Counter
	local dd = { Name = o.Name or "Dropdown", Order = order, EndOrder = order + 1, ParentHolder = self.TabHolder, Tabs = {}, Open = false }
	local header = New("TextButton", { Size = UDim2.new(1, 0, 0, 32), LayoutOrder = order, ClipsDescendants = true, Parent = self.TabHolder })
	corner(header, 5)
	local ic = New("ImageLabel", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 10, 0.5, 0), Size = UDim2.fromOffset(16, 16), Parent = header })
	local hasIcon = o.Icon and setIcon(ic, o.Icon) or false
	ic.Visible = hasIcon
	local lbl = New("TextLabel", {
		Position = UDim2.new(0, hasIcon and 34 or 12, 0, 0), Size = UDim2.new(1, -56, 1, 0), Text = dd.Name,
		TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = header,
	})
	bind(lbl, "TextColor3", "SubText")
	bind(ic, "ImageColor3", "SubText")
	local arrow = New("TextLabel", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(14, 14), Text = ">", TextSize = 11, Font = FONT_BOLD, Parent = header })
	bind(arrow, "TextColor3", "SubText")
	local wrap = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), ClipsDescendants = true, LayoutOrder = order + 1, Parent = self.TabHolder })
	local inner = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = wrap })
	list(inner, 2)
	dd.ParentInner = inner
	connect(inner:GetPropertyChangedSignal("AbsoluteSize"), function()
		if dd.Open then
			wrap.Size = UDim2.new(1, 0, 0, inner.AbsoluteSize.Y)
		end
	end)
	local function setOpen(v)
		dd.Open = v
		tw(arrow, 0.25, { Rotation = v and 90 or 0 })
		tw(wrap, 0.3, { Size = UDim2.new(1, 0, 0, v and inner.AbsoluteSize.Y or 0) })
	end
	header.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
			ripple(header, i.Position.X, i.Position.Y)
		end
	end)
	header.Activated:Connect(function()
		setOpen(not dd.Open)
	end)
	function dd:CreateTab(to)
		local t = createTab(win, to, inner, 14)
		table.insert(dd.Tabs, t)
		if not win.Current and t ~= win.FavTab then
			win:SelectTab(t)
		end
		return t
	end
	function dd:SetOpen(v)
		setOpen(v)
	end
	for _, to in ipairs(o.Tabs or {}) do
		dd:CreateTab(to)
	end
	if o.Open then
		task.defer(function()
			setOpen(true)
		end)
	end
	self.DropByName[dd.Name] = dd
	return dd
end

