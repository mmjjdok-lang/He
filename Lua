		Size = UDim2.fromOffset(380, 300), ZIndex = 100, ClipsDescendants = true, Parent = win.Gui,
	})
	bind(frame, "BackgroundColor3", "Background")
	corner(frame, 8)
	local sc = New("UIScale", { Scale = math.min(1, win.AutoScale + 0.1), Parent = frame })
	local top = New("Frame", { BackgroundColor3 = State.Theme.Panel, Size = UDim2.new(1, 0, 0, 40), ClipsDescendants = true, Active = true, Parent = frame })
	bind(top, "BackgroundColor3", "Panel")
	local tl = New("TextLabel", { Position = UDim2.fromOffset(12, 5), Size = UDim2.new(1, -60, 0, 18), Text = "KEYBIND MANAGER", Font = FONT_BOLD, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, Parent = top })
	New("Frame", { BackgroundColor3 = WHITE, Position = UDim2.fromOffset(12, 25), Size = UDim2.new(1, -60, 0, 2), Parent = top })
	New("TextLabel", { Position = UDim2.fromOffset(12, 28), Size = UDim2.new(1, -60, 0, 12), Text = "Rebind keys or disable shortcuts per Button / Toggle", Font = FONT_REG, TextSize = 10, TextColor3 = State.Theme.SubText, TextXAlignment = Enum.TextXAlignment.Left, Parent = top })
	local close = New("TextButton", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(26, 26), Text = "X", Font = FONT_BOLD, TextColor3 = State.Theme.SubText, Parent = top })
	close.Activated:Connect(function()
		frame.Visible = false
	end)
	local scroll = New("ScrollingFrame", { Position = UDim2.fromOffset(0, 40), Size = UDim2.new(1, 0, 1, -40), Parent = frame })
	pad(scroll, 8, 8, 8, 8)
	list(scroll, 5)
	makeDraggable(top, frame, {})
	win.KBFrame = frame

	function win.KBRefresh()
		for _, c in ipairs(scroll:GetChildren()) do
			if c:IsA("GuiObject") then
				c:Destroy()
			end
		end
		if #win.Binds == 0 then
			New("TextLabel", { Size = UDim2.new(1, 0, 0, 30), Text = "No Buttons or Toggles registered yet.", TextColor3 = State.Theme.SubText, Parent = scroll })
		end
		for i, e in ipairs(win.Binds) do
			local r = New("Frame", { BackgroundColor3 = State.Theme.Element, Size = UDim2.new(1, 0, 0, 36), LayoutOrder = i, Parent = scroll })
			corner(r, 6)
			New("TextLabel", {
				Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -150, 1, 0), TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
				RichText = true, TextSize = 12, Text = string.format('%s  <font size="9" color="#888888">%s</font>', e.Name, string.upper(e.Kind)), Parent = r,
			})
			local keyBtn = New("TextButton", {
				BackgroundTransparency = 0, BackgroundColor3 = State.Theme.Panel, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0),
				Size = UDim2.fromOffset(58, 24), Text = (win.Rebinding == e) and "..." or (e.Key and e.Key.Name or "None"), TextSize = 11, Font = FONT_BOLD, Parent = r,
			})
			corner(keyBtn, 5)
			local sw = New("TextButton", {
				BackgroundTransparency = 0, BackgroundColor3 = e.Enabled and State.Accent or State.Theme.Panel, AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -72, 0.5, 0), Size = UDim2.fromOffset(46, 24), Text = e.Enabled and "ON" or "OFF", TextSize = 11, Font = FONT_BOLD,
				TextColor3 = e.Enabled and BLACK or WHITE, Parent = r,
			})
			corner(sw, 5)
			keyBtn.Activated:Connect(function()
				win.Rebinding = e
				keyBtn.Text = "..."
			end)
			sw.Activated:Connect(function()
				if not e.Key then
					HE:Notify({ Title = "Keybind", Content = "Assign a key first.", Type = "Warning", Duration = 2 })
					return
				end
				e.Enabled = not e.Enabled
				win.KBRefresh()
				win:_Changed()
			end)
		end
	end
	win.KBRefresh()
	frame.Visible = true
end

-- ============================================================
-- CREATE WINDOW
-- ============================================================
function HE:CreateWindow(o)
	o = o or {}
	local gui = ensureGui()
	local accent = HE.GetColor(o.Color or "Olive")
	if accent then
		State.Accent = accent
		State.AccentName = (type(o.Color) == "string") and o.Color or "Custom"
	end
	if o.Theme and HE.Themes[o.Theme] then
		State.Theme, State.ThemeName = HE.Themes[o.Theme], o.Theme
	end

	if o.Splash ~= false then
		runSplash(gui, o.LoadingSteps)
	end
	if o.KeySystem then
		if not runKeySystem(gui, o.KeySystem) then
			destroyAll()
			return nil
		end
	end

	local size = o.Size or UDim2.new(0, 600, 0, 357)
	local win = setmetatable({
		Gui = gui, Tabs = {}, TabByName = {}, DropByName = {}, Flags = {}, Binds = {}, Elements = {}, FavSet = {}, Counter = 0,
		ConfigName = o.ConfigName or "HE_Default", AutoSave = o.AutoSave ~= false, ToggleKey = o.ToggleKey or Enum.KeyCode.RightControl,
		Compact = false, Visible = true, SizeFull = size,
	}, WindowMT)

	local cam = workspace.CurrentCamera
	local vp = (cam and cam.ViewportSize) or Vector2.new(1280, 720)
	win.AutoScale = math.clamp(math.min(vp.X / (size.X.Offset + 30), vp.Y / (size.Y.Offset + 30)), 0.5, 1)

	local main = New("CanvasGroup", {
		BackgroundColor3 = State.Theme.Background, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = size, GroupTransparency = 1, Parent = gui,
	})
	bind(main, "BackgroundColor3", "Background")
	corner(main, 8)
	local uiscale = New("UIScale", { Scale = win.AutoScale * State.UserScale * 0.9, Parent = main })
	win.Main, win.UIScale = main, uiscale

	-- Topbar ---------------------------------------------------
	local top = New("Frame", { BackgroundColor3 = State.Theme.Panel, Size = UDim2.new(1, 0, 0, TOP_H), ClipsDescendants = true, Active = true, Parent = main })
	bind(top, "BackgroundColor3", "Panel")
	local div = New("Frame", { BackgroundTransparency = 0.9, Position = UDim2.new(0, 0, 1, -1), Size = UDim2.new(1, 0, 0, 1), Parent = top })
	bind(div, "BackgroundColor3", "Line")
	local iconW = 12
	if o.Icon then
		local wi = New("ImageLabel", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 12, 0.5, 0), Size = UDim2.fromOffset(22, 22), Parent = top })
		if setIcon(wi, o.Icon) then
			iconW = 44
		else
			wi:Destroy()
		end
	end
	win.IconW = iconW
	local tHolder = New("Frame", { BackgroundTransparency = 1, Position = UDim2.new(0, iconW, 0, 0), Size = UDim2.new(1, -(iconW + 140), 1, 0), Parent = top })
	local title = New("TextLabel", { Position = UDim2.fromOffset(0, 5), Size = UDim2.new(1, 0, 0, 18), Text = o.Name or "HE", Font = FONT_BOLD, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = tHolder })
	bind(title, "TextColor3", "Text")
	New("Frame", { BackgroundColor3 = WHITE, Position = UDim2.fromOffset(0, 25), Size = UDim2.new(1, 0, 0, 2), Parent = tHolder })
	local subtitle = New("TextLabel", { Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, 0, 0, 14), Text = o.Subtitle or "", Font = FONT_REG, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = tHolder })
	bind(subtitle, "TextColor3", "SubText")
	win.TitleHolder, win.Title, win.Subtitle = tHolder, title, subtitle

	local function topButton(order, image, glyph, onClick)
		local b = New("TextButton", {
			BackgroundTransparency = 0, BackgroundColor3 = State.Theme.Element, AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -(8 + order * 32), 0.5, 0), Size = UDim2.fromOffset(26, 26), ClipsDescendants = true, Parent = top,
		})
		bind(b, "BackgroundColor3", "Element")
		corner(b, 4)
		local img = New("ImageLabel", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(16, 16), Parent = b })
		if not setIcon(img, image) then
			img:Destroy()
			New("TextLabel", { Size = UDim2.fromScale(1, 1), Text = glyph, Font = FONT_BOLD, TextSize = 13, Parent = b })
		end
		b.InputBegan:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
				ripple(b, i.Position.X, i.Position.Y)
			end
		end)
		b.Activated:Connect(function()
			playSound()
			onClick()
		end)
		return b
	end
	-- Delete (confirmation dialog)
	topButton(0, DELETE_IMAGE, "X", function()
		win:Dialog({
			Title = "Delete Script",
			Content = "Are you sure you want to delete the script?",
			Buttons = {
				{ Name = "No" },
				{ Name = "Yes", Accent = true, Callback = function() win:Destroy() end },
			},
		})
	end)
	-- Half-hide / focus mode
	topButton(1, HALF_HIDE_IMAGE, "-", function()
		win:SetCompact(not win.Compact)
	end)
	-- Full hide
	topButton(2, "minus", "_", function()
		win:SetVisible(false)
		HE:Notify({ Title = "Window Hidden", Content = "Use the open button to restore the window.", Duration = 3 })
	end)
	-- Keybind manager
	topButton(3, "keyboard", "K", function()
		win:OpenKeybindManager()
	end)

	if o.Draggable == "No" or o.Draggable == false then
		win.Draggable = false
	else
		win.Draggable = true
	end
	makeDraggable(top, main, { Enabled = function() return win.Draggable end })

	-- Body -----------------------------------------------------
	local body = New("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, TOP_H), Size = UDim2.new(1, 0, 1, -TOP_H), Parent = main })
	win.Body = body

	local side = New("Frame", { BackgroundColor3 = State.Theme.Panel, Size = UDim2.new(0, SIDEBAR_W, 1, 0), Parent = body })
	bind(side, "BackgroundColor3", "Panel")
	local sdiv = New("Frame", { BackgroundTransparency = 0.92, AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.new(0, 1, 1, 0), Parent = side })
	bind(sdiv, "BackgroundColor3", "Line")
	local sbg = New("Frame", { BackgroundColor3 = State.Theme.Element, Position = UDim2.fromOffset(8, 8), Size = UDim2.new(1, -16, 0, 26), Parent = side })
	bind(sbg, "BackgroundColor3", "Element")
	corner(sbg, 6)
	New("ImageLabel", { Image = SEARCH_ICON, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 7, 0.5, 0), Size = UDim2.fromOffset(14, 14), Parent = sbg })
	local searchBox = New("TextBox", {
		Position = UDim2.fromOffset(26, 0), Size = UDim2.new(1, -30, 1, 0), PlaceholderText = "Search elements...",
		PlaceholderColor3 = State.Theme.SubText, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, Parent = sbg,
	})
	win.SearchBox = searchBox
	local profileH = o.Profile and 52 or 0
	local tabHolder = New("ScrollingFrame", { Position = UDim2.fromOffset(6, 42), Size = UDim2.new(1, -12, 1, -(48 + profileH)), ScrollBarThickness = 0, Parent = side })
	list(tabHolder, 2)
	win.TabHolder = tabHolder

	if o.Profile then
		local pf = New("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 8, 1, -6), Size = UDim2.new(1, -16, 0, 42), Parent = side })
		local av = New("ImageLabel", {
			BackgroundColor3 = State.Theme.Element, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.fromOffset(34, 34),
			Image = string.format("rbxthumb://type=AvatarHeadShot&id=%d&w=60&h=60", LocalPlayer.UserId), Parent = pf,
		})
		av.BackgroundTransparency = 0
		corner(av, 17)
		local dn = New("TextLabel", { Position = UDim2.fromOffset(42, 5), Size = UDim2.new(1, -42, 0, 16), Text = LocalPlayer.DisplayName, Font = FONT_BOLD, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = pf })
		bind(dn, "TextColor3", "Text")
		local un = New("TextLabel", { Position = UDim2.fromOffset(42, 21), Size = UDim2.new(1, -42, 0, 14), Text = "@" .. LocalPlayer.Name, Font = FONT_REG, TextSize = 10, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = pf })
		bind(un, "TextColor3", "SubText")
	end

	local content = New("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(SIDEBAR_W, 0), Size = UDim2.new(1, -SIDEBAR_W, 1, 0), ClipsDescendants = true, Parent = body })
	local pageHolder = New("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = content })
	win.Content, win.PageHolder = content, pageHolder

	-- Search results page (searchable element filter)
	local searchPage = New("ScrollingFrame", { Size = UDim2.fromScale(1, 1), Visible = false, Parent = pageHolder })
	pad(searchPage, 8, 8, 8, 8)
	list(searchPage, 4)
	connect(searchBox:GetPropertyChangedSignal("Text"), function()
		local q = string.lower(searchBox.Text):gsub("^%s+", ""):gsub("%s+$", "")
		for _, c in ipairs(searchPage:GetChildren()) do
			if c:IsA("GuiObject") then
				c:Destroy()
			end
		end
		if q == "" then
			searchPage.Visible = false
			if win.Current then
				win.Current.Page.Visible = true
			end
			return
		end
		if win.Current then
			win.Current.Page.Visible = false
		end
		searchPage.Visible = true
		local n = 0
		for _, e in ipairs(win.Elements) do
			if e.Kind ~= "Section" and e.Kind ~= "Label" and string.find(string.lower(e.Name), q, 1, true) then
				n = n + 1
				local b = New("TextButton", { BackgroundTransparency = 0, BackgroundColor3 = State.Theme.Element, Size = UDim2.new(1, 0, 0, 30), LayoutOrder = n, ClipsDescendants = true, Parent = searchPage })
				corner(b, 5)
				New("TextLabel", { Position = UDim2.fromOffset(10, 0), Size = UDim2.new(0.6, -10, 1, 0), Text = e.Name, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, TextSize = 12, Parent = b })
				New("TextLabel", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 0), Size = UDim2.new(0.4, -10, 1, 0), Text = e.Tab.Name .. "  /  " .. e.Kind, TextXAlignment = Enum.TextXAlignment.Right, TextTruncate = Enum.TextTruncate.AtEnd, TextSize = 10, Font = FONT_REG, TextColor3 = State.Theme.SubText, Parent = b })
				b.Activated:Connect(function()
					win:SelectTab(e.Tab)
					task.spawn(function()
						task.wait(0.08)
						local pg = e.Tab.Page
						local y = e.Frame.AbsolutePosition.Y - pg.AbsolutePosition.Y + pg.CanvasPosition.Y - 8
						pg.CanvasPosition = Vector2.new(0, math.max(y, 0))
						if e.Frame.BackgroundTransparency < 1 then
							tw(e.Frame, 0.2, { BackgroundColor3 = State.Accent:Lerp(BLACK, 0.5) })
							task.wait(0.3)
							tw(e.Frame, 0.4, { BackgroundColor3 = State.Theme.Element })
						end
					end)
				end)
			end
		end
		if n == 0 then
			New("TextLabel", { Size = UDim2.new(1, 0, 0, 30), Text = "No matching elements.", TextColor3 = State.Theme.SubText, Parent = searchPage })
		end
	end)

	-- Favorites tab
	if o.Favorites ~= false then
		win.FavTab = createTab(win, { Name = "Favorites", Icon = "star", Order = 1 }, tabHolder, 0)
		win:_RefreshFavorites()
	end

	-- Open button ----------------------------------------------
	local ob = o.OpenButton or {}
	local openBtn = New("Frame", {
		BackgroundColor3 = State.Theme.Panel, BackgroundTransparency = ob.Transparency or 0.1, AnchorPoint = Vector2.new(0.5, 0.5),
		Position = ob.Position or UDim2.new(0, 40, 0.5, 0), Size = ob.Size or UDim2.fromOffset(46, 46), ClipsDescendants = true, Active = true, ZIndex = 50, Parent = gui,
	})
	bind(openBtn, "BackgroundColor3", "Panel")
	corner(openBtn, 10)
	local obStroke = New("UIStroke", { Thickness = 1.5, Transparency = ob.StrokeTransparency or 0.3, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = openBtn })
	bind(obStroke, "Color", "Accent")
	local obImg = New("ImageLabel", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.6, 0.6), Parent = openBtn })
	if not (ob.Image and setIcon(obImg, ob.Image)) then
		obImg:Destroy()
		New("TextLabel", { Size = UDim2.fromScale(1, 1), Text = "HE", Font = FONT_BOLD, TextSize = 16, Parent = openBtn })
	end
	makeDraggable(openBtn, openBtn, { OnClick = function() win:Toggle() end })
	win.OpenButton = openBtn

	-- Global key handler (toggle key + keybinds + rebinding)
	connect(UserInputService.InputBegan, function(input, gp)
		if input.UserInputType ~= Enum.UserInputType.Keyboard then
			return
		end
		if win.Rebinding then
			local e = win.Rebinding
			win.Rebinding = nil
			if input.KeyCode == Enum.KeyCode.Escape then
				-- cancel
			elseif input.KeyCode == Enum.KeyCode.Backspace or input.KeyCode == Enum.KeyCode.Delete then
				e.Key, e.Enabled = nil, false
			else
				e.Key, e.Enabled = input.KeyCode, true
			end
			if win.KBRefresh then
				win.KBRefresh()
			end
			win:_Changed()
			return
		end
		if gp or UserInputService:GetFocusedTextBox() then
			return
		end
		if input.KeyCode == win.ToggleKey then
			win:Toggle()
			return
		end
		for _, e in ipairs(win.Binds) do
			if e.Enabled and e.Key == input.KeyCode then
				safeCall(e.Fire)
			end
		end
	end)

	-- Animate in
	main.Visible = true
	tw(main, 0.4, { GroupTransparency = State.Transparency })
	tw(uiscale, 0.4, { Scale = win.AutoScale * State.UserScale }, Enum.EasingStyle.Back)
	return win
end

HE.Destroy = destroyAll

return HE
