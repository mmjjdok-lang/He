		stroke(thumb, WHITE, 1, 0)
		local txt = New("TextLabel", { Size = UDim2.fromScale(1, 1), Text = leftName, TextSize = 9, Font = FONT_BOLD, Parent = thumb })
		visual = function(animate)
			local pos = state and UDim2.fromOffset(31, 3) or UDim2.fromOffset(3, 3)
			local col = state and State.Accent:Lerp(BLACK, 0.65) or BLACK
			txt.Text = state and rightName or leftName
			if animate then
				tw(thumb, 0.25, { Position = pos }, Enum.EasingStyle.Back)
				tw(track, 0.25, { BackgroundColor3 = col })
			else
				thumb.Position = pos
				track.BackgroundColor3 = col
			end
		end
	else
		local box = New("Frame", { BackgroundColor3 = BLACK, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(20, 20), Parent = row })
		local st = stroke(box, WHITE, 1, 0.3)
		local fill = New("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(0, 0), Parent = box })
		fill.BackgroundColor3 = State.Accent
		local check = New("TextLabel", { Size = UDim2.fromScale(1, 1), Text = "OK", TextSize = 8, Font = FONT_BOLD, TextColor3 = BLACK, TextTransparency = 1, Parent = box })
		visual = function(animate)
			local size = state and UDim2.fromOffset(20, 20) or UDim2.fromOffset(0, 0)
			if animate then
				tw(fill, 0.2, { Size = size, BackgroundColor3 = State.Accent }, Enum.EasingStyle.Back)
				tw(check, 0.2, { TextTransparency = state and 0 or 1 })
				tw(st, 0.2, { Transparency = state and 0 or 0.3 })
			else
				fill.Size, fill.BackgroundColor3 = size, State.Accent
				check.TextTransparency = state and 0 or 1
				st.Transparency = state and 0 or 0.3
			end
		end
	end
	addRefresher(function()
		visual(false)
	end)

	local entry
	local function setState(v, silent)
		state = v and true or false
		visual(true)
		if not silent then
			safeCall(o.Callback, state)
			win:_Changed()
			if entry and entry.Pinned and not win._favBusy then
				win:_RefreshFavorites()
			end
		end
	end

	local hit = New("TextButton", { Size = UDim2.fromScale(1, 1), ZIndex = 2, Parent = row })
	hoverFx(hit, row)
	rippleOn(hit, row)
	local fav = { suppress = false }
	if not o._Proxy then
		entry = win:_RegisterBind({
			Name = o.Name or "Toggle", Kind = "Toggle", Keybind = o.Keybind,
			Fire = function()
				playSound()
				setState(not state)
			end,
		})
		entry.Proxy = function(tab)
			tab:CreateToggle({
				Name = o.Name, Description = "Pinned shortcut", Style = style, Default = state, LeftName = leftName, RightName = rightName,
				Callback = function(v)
					win._favBusy = true
					setState(v)
					win._favBusy = false
				end,
				_Proxy = true,
			})
		end
		fav = attachFavorite(win, row, entry)
		win:_Flag(o.Flag or o.Name, function()
			return state
		end, setState)
	end
	hit.Activated:Connect(function()
		if fav.suppress then
			return
		end
		playSound()
		setState(not state)
	end)

	state = o.Default == true
	visual(false)
	if state and o.FireDefault then
		safeCall(o.Callback, state)
	end
	self:_Add(row, o.Name or "Toggle", "Toggle", o._Proxy)
	return { Frame = row, Set = setState, Get = function() return state end }
end

-- ---------- Slider ----------
function Elements:CreateSlider(o)
	o = o or {}
	local win = self.Window
	local min, max, inc = o.Min or 0, o.Max or 100, o.Increment or 1
	local suffix = o.Suffix or ""
	local dec = 0
	local ds = tostring(inc):match("%.(%d+)")
	if ds then
		dec = #ds
	end
	local row, holder = buildRow(self, o, 0, 84)
	local valueLbl = New("TextLabel", {
		AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 10), Size = UDim2.fromOffset(80, 16),
		TextXAlignment = Enum.TextXAlignment.Right, TextSize = 12, Text = "", Parent = row,
	})
	bind(valueLbl, "TextColor3", "SubText")
	local track = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 16), LayoutOrder = 10, Active = true, Parent = holder })
	local bar = New("Frame", { BackgroundColor3 = WHITE, BackgroundTransparency = 0.85, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.new(1, 0, 0, 4), Parent = track })
	corner(bar, 2)
	local fill = New("Frame", { Size = UDim2.fromScale(0, 1), Parent = bar })
	bind(fill, "BackgroundColor3", "Accent")
	corner(fill, 2)
	local knob = New("Frame", { BackgroundColor3 = WHITE, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(1, 0.5), Size = UDim2.fromOffset(10, 10), Parent = fill })
	corner(knob, 5)

	local value = min
	local function setValue(v, silent)
		v = math.clamp(tonumber(v) or min, min, max)
		v = math.floor((v - min) / inc + 0.5) * inc + min
		v = tonumber(string.format("%." .. dec .. "f", math.clamp(v, min, max)))
		local changed = (v ~= value)
		value = v
		valueLbl.Text = tostring(v) .. suffix
		local ratio = (max == min) and 0 or (v - min) / (max - min)
		tw(fill, 0.1, { Size = UDim2.fromScale(ratio, 1) }, Enum.EasingStyle.Quad)
		if changed and not silent then
			safeCall(o.Callback, v)
			win:_Changed()
		end
	end
	trackPointer(track, function(pos)
		local r = math.clamp((pos.X - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
		setValue(min + (max - min) * r)
	end, function()
		self:_SetScrolling(false)
	end, function()
		self:_SetScrolling(true)
	end)
	setValue(o.Default or min, true)
	win:_Flag(o.Flag or o.Name, function()
		return value
	end, setValue)
	self:_Add(row, o.Name or "Slider", "Slider")
	return { Frame = row, Set = setValue, Get = function() return value end }
end

-- ---------- Dropdown (single / multi, search, above / below / over) ----------
function Elements:CreateDropdown(o)
	o = o or {}
	local win = self.Window
	local multi = o.Multi == true
	local options = (type(o.Options) == "function" and o.Options()) or o.Options or {}
	local images = o.Images or {}
	local selected = {}
	local row = buildRow(self, o, 130)
	local valueLbl = New("TextLabel", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -30, 0.5, 0), Size = UDim2.fromOffset(100, 16),
		TextXAlignment = Enum.TextXAlignment.Right, TextTruncate = Enum.TextTruncate.AtEnd, TextSize = 12, Text = "None", Parent = row,
	})
	bind(valueLbl, "TextColor3", "SubText")
	local arrow = New("TextLabel", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(14, 14), Text = "v", TextSize = 11, Font = FONT_BOLD, Parent = row })
	bind(arrow, "TextColor3", "SubText")
	local hit = New("TextButton", { Size = UDim2.fromScale(1, 1), ZIndex = 2, Parent = row })
	hoverFx(hit, row)
	rippleOn(hit, row)

	local dd = { IsOpen = false, Frame = row }
	local function getValue()
		if multi then
			local r = {}
			for _, opt in ipairs(options) do
				if selected[opt] then
					table.insert(r, opt)
				end
			end
			return r
		end
		for _, opt in ipairs(options) do
			if selected[opt] then
				return opt
			end
		end
		return nil
	end
	local function refreshDisplay()
		local v = getValue()
		if multi then
			valueLbl.Text = (#v > 0) and table.concat(v, ", ") or "None"
		else
			valueLbl.Text = v or "None"
		end
	end
	local function setValue(v, silent)
		table.clear(selected)
		if multi then
			if type(v) == "table" then
				for _, x in ipairs(v) do
					selected[x] = true
				end
			elseif v then
				selected[v] = true
			end
		else
			if type(v) == "table" then
				v = v[1]
			end
			if v then
				selected[v] = true
			end
		end
		refreshDisplay()
		if not silent then
			safeCall(o.Callback, getValue())
			win:_Changed()
		end
	end

	local closeFn
	local function open()
		if dd.IsOpen then
			return
		end
		dd.IsOpen = true
		local bag = {}
		local catcher = New("TextButton", { Size = UDim2.fromScale(1, 1), ZIndex = 200, Parent = win.Gui })
		local abs, sz = row.AbsolutePosition, row.AbsoluteSize
		local searchH = o.Search and 34 or 0
		local rows = math.max(1, math.min(#options, 6))
		local height = searchH + rows * 28 + 10
		local width = math.max(sz.X, 180)
		local vp = win.Gui.AbsoluteSize
		local mode = o.Position or "Below"
		local y
		if mode == "Above" then
			y = abs.Y - height - 4
		elseif mode == "Over" then
			y = abs.Y
		else
			y = abs.Y + sz.Y + 4
			if y + height > vp.Y - 6 then
				y = abs.Y - height - 4
			end
		end
		y = math.clamp(y, 6, math.max(6, vp.Y - height - 6))
		local x = math.clamp(abs.X, 6, math.max(6, vp.X - width - 6))
		local popup = New("Frame", {
			BackgroundColor3 = State.Theme.Panel, Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(width, 0),
			ClipsDescendants = true, ZIndex = 201, Parent = win.Gui,
		})
		corner(popup, 6)
		tw(popup, 0.22, { Size = UDim2.fromOffset(width, height) })
		tw(arrow, 0.2, { Rotation = 180 })
		local filter = ""
		local box
		if o.Search then
			local sb = New("Frame", { BackgroundColor3 = State.Theme.Element, Position = UDim2.fromOffset(4, 4), Size = UDim2.new(1, -8, 0, 26), Parent = popup })
			corner(sb, 5)
			New("ImageLabel", { Image = SEARCH_ICON, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 7, 0.5, 0), Size = UDim2.fromOffset(15, 15), Parent = sb })
			box = New("TextBox", { Position = UDim2.fromOffset(28, 0), Size = UDim2.new(1, -34, 1, 0), PlaceholderText = "Search...", PlaceholderColor3 = State.Theme.SubText, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Parent = sb })
		end
		local scroll = New("ScrollingFrame", { Position = UDim2.fromOffset(4, searchH + 4), Size = UDim2.new(1, -8, 1, -(searchH + 8)), Parent = popup })
		list(scroll, 2)
		local function build()
			local keep = scroll.CanvasPosition
			for _, c in ipairs(scroll:GetChildren()) do
				if c:IsA("GuiObject") then
					c:Destroy()
				end
			end
			local n = 0
			for _, opt in ipairs(options) do
				if filter == "" or string.find(string.lower(opt), filter, 1, true) then
					n = n + 1
					local isSel = selected[opt] == true
					local item = New("TextButton", { BackgroundColor3 = WHITE, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 26), LayoutOrder = n, ClipsDescendants = true, Parent = scroll })
					corner(item, 4)
					local img = images[opt] and resolveIcon(images[opt])
					local lx = 8
					if type(img) == "string" then
						New("ImageLabel", { Image = img, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 6, 0.5, 0), Size = UDim2.fromOffset(18, 18), Parent = item })
						lx = 30
					end
					New("TextLabel", {
						Position = UDim2.fromOffset(lx, 0), Size = UDim2.new(1, -(lx + 26), 1, 0), Text = opt, TextXAlignment = Enum.TextXAlignment.Left,
						TextTruncate = Enum.TextTruncate.AtEnd, TextSize = 12, TextColor3 = isSel and State.Accent or State.Theme.Text, Parent = item,
					})
					if isSel then
						New("TextLabel", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(16, 16), Text = "*", Font = FONT_BOLD, TextColor3 = State.Accent, Parent = item })
					end
					item.MouseEnter:Connect(function()
						tw(item, 0.12, { BackgroundTransparency = 0.92 })
					end)
					item.MouseLeave:Connect(function()
						tw(item, 0.12, { BackgroundTransparency = 1 })
					end)
					item.InputBegan:Connect(function(i)
						if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
							ripple(item, i.Position.X, i.Position.Y)
						end
					end)
					item.Activated:Connect(function()
						if multi then
							if selected[opt] then
								selected[opt] = nil
							else
								selected[opt] = true
							end
							refreshDisplay()
							safeCall(o.Callback, getValue())
							win:_Changed()
							build()
						else
							setValue(opt)
							if closeFn then
								closeFn()
							end
						end
					end)
				end
			end
			task.defer(function()
				scroll.CanvasPosition = keep
			end)
		end
		build()
		if box then
			connect(box:GetPropertyChangedSignal("Text"), function()
				filter = string.lower(box.Text)
				build()
			end, bag)
		end
		closeFn = function()
			if not dd.IsOpen then
				return
			end
			dd.IsOpen = false
			clearBag(bag)
			tw(arrow, 0.2, { Rotation = 0 })
			tw(popup, 0.18, { Size = UDim2.fromOffset(width, 0) })
			catcher:Destroy()
			task.delay(0.2, function()
				popup:Destroy()
			end)
		end
		catcher.Activated:Connect(closeFn)
	end

	hit.Activated:Connect(function()
		if dd.IsOpen then
			if closeFn then
				closeFn()
			end
		else
			open()
		end
	end)
	setValue(o.Default, true)
	win:_Flag(o.Flag or o.Name, getValue, setValue)
	dd.Set, dd.Get = setValue, getValue
	function dd:Refresh(newOptions, newImages)
		options = newOptions or options
		images = newImages or images
		for k in pairs(selected) do
			if not table.find(options, k) then
				selected[k] = nil
			end
		end
		refreshDisplay()
	end
	function dd:Open()
		open()
	end
	function dd:Close()
		if closeFn then
			closeFn()
		end
	end
	self:_Add(row, o.Name or "Dropdown", "Dropdown")
	return dd
end

-- ---------- Player selector (auto-updating) ----------
function Elements:CreatePlayerDropdown(o)
	o = o or {}
	local function listPlayers()
		local names, imgs = {}, {}
		for _, p in ipairs(Players:GetPlayers()) do
			if o.IncludeSelf or p ~= LocalPlayer then
				table.insert(names, p.Name)
				imgs[p.Name] = string.format("rbxthumb://type=AvatarHeadShot&id=%d&w=48&h=48", p.UserId)
			end
		end
		table.sort(names)
		return names, imgs
	end
	local names, imgs = listPlayers()
	local dd = self:CreateDropdown({
		Name = o.Name or "Select Player", Description = o.Description, Options = names, Images = imgs, Search = o.Search ~= false,
		Multi = o.Multi, Callback = o.Callback, Flag = o.Flag, Position = o.Position, Tooltip = o.Tooltip, Tag = o.Tag,
	})
	local function refresh()
		local n, i = listPlayers()
		dd:Refresh(n, i)
	end
	connect(Players.PlayerAdded, function()
		task.delay(0.2, refresh)
	end)
	connect(Players.PlayerRemoving, function()
		task.delay(0.2, refresh)
	end)
	return dd
end

