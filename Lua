local function rn()
	return (HttpService:GenerateGUID(false):gsub("[{}%-]", ""))
end

local function safeCall(fn, ...)
	if type(fn) ~= "function" then
		return
	end
	local ok, err = pcall(fn, ...)
	if not ok then
		warn("[HE] Callback error: " .. tostring(err))
	end
end

local function connect(signal, fn, bag)
	local c = signal:Connect(fn)
	table.insert(bag or Conns, c)
	return c
end

local function clearBag(bag)
	for _, c in ipairs(bag) do
		pcall(function()
			c:Disconnect()
		end)
	end
	table.clear(bag)
end

