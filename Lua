-- ============================================================
-- INTERACTION HELPERS
-- ============================================================
local function uiScaleOf(inst)
	local p = inst
	while p do
		local s = p:FindFirstChildOfClass("UIScale")
		if s then
			return s.Scale
		end
		p = p.Parent
	end
	return 1
end

-- Water ripple at press point (parent should have ClipsDescendants = true)
local function ripple(parent, x, y, color)
	local sc = uiScaleOf(parent)
	local ap = parent.AbsolutePosition
	local size = math.max(parent.AbsoluteSize.X, parent.AbsoluteSize.Y) * 2 / sc
	local r = New("Frame", {
		BackgroundColor3 = color or WHITE, BackgroundTransparency = 0.75,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset((x - ap.X) / sc, (y - ap.Y) / sc),
		Size = UDim2.fromOffset(0, 0), ZIndex = 50, Parent = parent,
	})
	corner(r, 999)
	tw(r, 0.6, { Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1 })
	task.delay(0.65, function()
		r:Destroy()
	end)
end

local function clampPos(udim)
	local vp = (Lib.Gui and Lib.Gui.AbsoluteSize) or Vector2.new(1280, 720)
	local x = math.clamp(udim.X.Scale * vp.X + udim.X.Offset, 20, vp.X - 20)
	local y = math.clamp(udim.Y.Scale * vp.Y + udim.Y.Offset, 20, vp.Y - 20)
	return UDim2.fromOffset(x, y)
end

-- Single-finger heavy drag. Only the first pointer that touched the handle
-- controls the movement; every other finger is ignored until it is released.
local function makeDraggable(handle, target, opts)
	opts = opts or {}
	local active, startPos, startUDim, moved, lastPos, lastT, vel, goal
	connect(handle.InputBegan, function(input)
		if active then
			return
		end
		local t = input.UserInputType
		if t ~= Enum.UserInputType.Touch and t ~= Enum.UserInputType.MouseButton1 then
			return
		end
		if opts.Enabled and not opts.Enabled() then
			return
		end
		active = input
		startPos = input.Position
		startUDim = target.Position
		goal = startUDim
		moved = false
		lastPos = input.Position
		lastT = tick()
		vel = Vector2.new(0, 0)
		ripple(handle, input.Position.X, input.Position.Y)
		playSound()
	end)
	connect(UserInputService.InputChanged, function(input)
		if not active then
			return
		end
		if active.UserInputType == Enum.UserInputType.Touch then
			if input ~= active then
				return
			end
		elseif input.UserInputType ~= Enum.UserInputType.MouseMovement then
			return
		end
		local p = input.Position
		local dx, dy = p.X - startPos.X, p.Y - startPos.Y
		if not moved and math.sqrt(dx * dx + dy * dy) < 6 then
			return
		end
		moved = true
		local now = tick()
		local dt = math.max(now - lastT, 1 / 240)
		vel = Vector2.new((p.X - lastPos.X) / dt, (p.Y - lastPos.Y) / dt)
		lastPos, lastT = p, now
		goal = clampPos(UDim2.new(startUDim.X.Scale, startUDim.X.Offset + dx, startUDim.Y.Scale, startUDim.Y.Offset + dy))
		tw(target, 0.22, { Position = goal }, Enum.EasingStyle.Sine)
	end)
	connect(UserInputService.InputEnded, function(input)
		if not active then
			return
		end
		local same = (input == active)
			or (active.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseButton1)
		if not same then
			return
		end
		local wasMoved = moved
		active = nil
		if wasMoved then
			if tick() - lastT < 0.1 then
				local ix = math.clamp(vel.X * 0.12, -140, 140)
				local iy = math.clamp(vel.Y * 0.12, -140, 140)
				tw(target, 0.5, { Position = clampPos(UDim2.new(goal.X.Scale, goal.X.Offset + ix, goal.Y.Scale, goal.Y.Offset + iy)) })
			end
		elseif opts.OnClick then
			safeCall(opts.OnClick)
		end
	end)
end

-- Single-pointer tracker used by sliders, color picker etc.
local function trackPointer(gui, onMove, onBegin, onEnd, bag)
	local active
	connect(gui.InputBegan, function(input)
		if active then
			return
		end
		local t = input.UserInputType
		if t == Enum.UserInputType.Touch or t == Enum.UserInputType.MouseButton1 then
			active = input
			if onBegin then
				onBegin()
			end
			onMove(input.Position)
		end
	end, bag)
	connect(UserInputService.InputChanged, function(input)
		if not active then
			return
		end
		if active.UserInputType == Enum.UserInputType.Touch then
			if input ~= active then
				return
			end
		elseif input.UserInputType ~= Enum.UserInputType.MouseMovement then
			return
		end
		onMove(input.Position)
	end, bag)
	connect(UserInputService.InputEnded, function(input)
		if active and (input == active or (active.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseButton1)) then
			active = nil
			if onEnd then
				onEnd()
			end
		end
	end, bag)
end

-- Tooltip (hover on PC, long-press on mobile) ---------------------
local function ensureTip()
	if Lib.Tip and Lib.Tip.Parent then
		return Lib.Tip
	end
	local tip = New("Frame", { BackgroundColor3 = State.Theme.Panel, Visible = false, ZIndex = 500, Size = UDim2.fromOffset(100, 24), Parent = Lib.Gui })
	corner(tip, 5)
	local lbl = New("TextLabel", { Size = UDim2.fromScale(1, 1), TextSize = 11, Font = FONT_REG, TextWrapped = true, Parent = tip })
	tip:SetAttribute("L", "x")
	Lib.Tip = tip
	Lib.TipLabel = lbl
	return tip
end

local function showTip(text, pos)
	local tip = ensureTip()
	local sz = TextService:GetTextSize(text, 11, FONT_REG, Vector2.new(220, 1000))
	local w, h = sz.X + 18, sz.Y + 12
	local vp = Lib.Gui.AbsoluteSize
	tip.BackgroundColor3 = State.Theme.Panel
	Lib.TipLabel.Text = text
	tip.Size = UDim2.fromOffset(w, h)
	tip.Position = UDim2.fromOffset(math.clamp(pos.X + 12, 4, vp.X - w - 4), math.clamp(pos.Y + 16, 4, vp.Y - h - 4))
	tip.Visible = true
end

local function hideTip()
	if Lib.Tip then
		Lib.Tip.Visible = false
	end
end

local function attachTooltip(gui, text)
	if not text or text == "" then
		return
	end
	local token = 0
	connect(gui.MouseEnter, function()
		token = token + 1
		local my = token
		task.delay(0.45, function()
			if my == token then
				showTip(text, UserInputService:GetMouseLocation())
			end
		end)
	end)
	connect(gui.MouseLeave, function()
		token = token + 1
		hideTip()
	end)
	connect(gui.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			token = token + 1
			local my = token
			task.delay(0.5, function()
				if my == token then
					showTip(text, gui.AbsolutePosition + Vector2.new(0, gui.AbsoluteSize.Y))
					task.delay(1.6, function()
						if my == token then
							hideTip()
						end
					end)
				end
			end)
		end
	end)
	connect(gui.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			token = token + 1
		end
	end)
end

-- Tag / badge pill -------------------------------------------------
local TagColors = {
	NEW = rgb(46, 204, 113), UPDATED = rgb(52, 152, 219), BETA = rgb(243, 156, 18),
	VIP = rgb(241, 196, 15), HOT = rgb(231, 76, 60),
}

local function makeTag(parent, tag)
	if not tag then
		return nil
	end
	local text, color
	if type(tag) == "table" then
		text, color = tag.Text, tag.Color
	else
		text = tag
	end
	text = tostring(text):upper()
	color = color or TagColors[text] or State.Accent
	local w = TextService:GetTextSize(text, 9, FONT_BOLD, Vector2.new(200, 12)).X + 12
	local pill = New("TextLabel", {
		BackgroundTransparency = 0.78, BackgroundColor3 = color, Size = UDim2.fromOffset(w, 14),
		Text = text, TextColor3 = color, TextSize = 9, Font = FONT_BOLD, Parent = parent,
	})
	corner(pill, 7)
	return pill, w
end

-- Clipboard helper --------------------------------------------------
function HE:Copy(text, label)
	local fn = setclipboard or toclipboard or (Clipboard and Clipboard.set)
	if fn then
		local ok = pcall(fn, tostring(text))
		if ok then
			HE:Notify({ Title = "Copied", Content = (label or "Text") .. " copied to clipboard.", Type = "Success", Duration = 2.5 })
			return true
		end
	end
	HE:Notify({ Title = "Clipboard", Content = "Clipboard is not supported by this executor.", Type = "Warning", Duration = 3 })
	return false
end

