function WindowMT:SetScale(s)
	State.UserScale = math.clamp(tonumber(s) or 1, 0.5, 1.5)
	tw(self.UIScale, 0.25, { Scale = self.AutoScale * State.UserScale })
end

function WindowMT:SetTransparency(t)
	State.Transparency = math.clamp(tonumber(t) or 0, 0, 0.8)
