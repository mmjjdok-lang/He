-- KEY SYSTEM
-- ============================================================
local function runKeySystem(gui, cfg)
	cfg = cfg or {}
	local function valid(k)
		if cfg.Validate then
			local ok, res = pcall(cfg.Validate, k)
			return ok and res == true
		end
		if cfg.Keys then
			return table.find(cfg.Keys, k) ~= nil
		end
		return k == cfg.Key
	end
	local saveFile = (cfg.SaveFile or "HE_Key.txt")
	if cfg.SaveKey and typeof(isfile) == "function" and isfile(saveFile) then
		local ok, saved = pcall(readfile, saveFile)
		if ok and valid(saved) then
			return true
		end
	end
	local done, result = false, false
	local root = New("Frame", { BackgroundColor3 = BLACK, BackgroundTransparency = 0.25, Size = UDim2.fromScale(1, 1), ZIndex = 900, Active = true, Parent = gui })
	local card = New("Frame", {
		BackgroundColor3 = State.Theme.Panel, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(340, 214), Parent = root,
	})
	corner(card, 8)
	local sc = New("UIScale", { Scale = 0.9, Parent = card })
	tw(sc, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	New("TextLabel", { Position = UDim2.fromOffset(16, 12), Size = UDim2.new(1, -60, 0, 20), Text = cfg.Title or "KEY VERIFICATION", Font = FONT_BOLD, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Left, Parent = card })
	New("Frame", { BackgroundColor3 = WHITE, Position = UDim2.fromOffset(16, 36), Size = UDim2.new(1, -32, 0, 2), Parent = card })
	New("TextLabel", {
		Position = UDim2.fromOffset(16, 46), Size = UDim2.new(1, -32, 0, 30), Text = cfg.Note or "Enter your key to continue.",
		TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
		Font = FONT_REG, TextSize = 12, TextColor3 = State.Theme.SubText, Parent = card,
	})
	local boxBg = New("Frame", { BackgroundColor3 = State.Theme.Element, Position = UDim2.fromOffset(16, 82), Size = UDim2.new(1, -32, 0, 34), Parent = card })
	corner(boxBg, 6)
	local input = New("TextBox", { Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -20, 1, 0), PlaceholderText = "Enter key...", PlaceholderColor3 = State.Theme.SubText, TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false, Parent = boxBg })
	local msg = New("TextLabel", { Position = UDim2.fromOffset(16, 122), Size = UDim2.new(1, -32, 0, 14), Text = "", TextSize = 11, TextColor3 = NotifColors.Error, TextXAlignment = Enum.TextXAlignment.Left, Parent = card })
	local hasLink = cfg.Link ~= nil
	local function mkBtn(text, x, w, accent)
		local b = New("TextButton", {
			BackgroundTransparency = 0, BackgroundColor3 = accent and State.Accent or State.Theme.Element,
			Position = UDim2.new(0, x, 1, -46), Size = UDim2.new(w, -((hasLink and 6) or 0), 0, 32), Text = text,
			Font = FONT_BOLD, TextColor3 = accent and BLACK or WHITE, ClipsDescendants = true, Parent = card,
		})
		corner(b, 6)
		b.InputBegan:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
				ripple(b, i.Position.X, i.Position.Y)
			end
		end)
		return b
	end
	local verify = mkBtn("Verify", 16, hasLink and 0.5 or 1, true)
	if not hasLink then
		verify.Size = UDim2.new(1, -32, 0, 32)
	else
		verify.Size = UDim2.new(0.5, -19, 0, 32)
	end
	if hasLink then
		local getKey = mkBtn("Get Key", 0, 0.5, false)
		getKey.Position = UDim2.new(0.5, 3, 1, -46)
		getKey.Size = UDim2.new(0.5, -19, 0, 32)
		getKey.Activated:Connect(function()
			HE:Copy(cfg.Link, "Key link")
		end)
	end
	local close = New("TextButton", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 10), Size = UDim2.fromOffset(24, 24), Text = "X", Font = FONT_BOLD, TextColor3 = State.Theme.SubText, Parent = card })
	close.Activated:Connect(function()
		done, result = true, false
	end)
	verify.Activated:Connect(function()
		playSound()
		if valid(input.Text) then
			if cfg.SaveKey and typeof(writefile) == "function" then
				pcall(writefile, saveFile, input.Text)
			end
			done, result = true, true
		else
			msg.Text = "Invalid key. Please try again."
			for i = 1, 4 do
				tw(card, 0.04, { Position = UDim2.new(0.5, (i % 2 == 0) and 8 or -8, 0.5, 0) })
				task.wait(0.05)
			end
			tw(card, 0.08, { Position = UDim2.fromScale(0.5, 0.5) })
		end
	end)
	repeat
		task.wait(0.1)
	until done
	tw(sc, 0.2, { Scale = 0.9 })
	tw(root, 0.2, { BackgroundTransparency = 1 })
	task.wait(0.2)
	root:Destroy()
	return result
end

